# Скопируйте в .env перед первым запуском: cp .env.example .env
# Значения ниже годятся только для локального запуска.

POSTGRES_DB=room_rental
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Не короче 32 символов, иначе приложение не стартует
JWT_KEY=local-development-key-change-me-0123456789

ADMIN_EMAIL=admin@roomrental.local
ADMIN_PASSWORD=local-admin-password
